# Copy to .env. Never commit .env or service-account JSON.
ENVIRONMENT=development
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Comma-separated exact frontend origins:
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Use a Firebase Admin service-account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Alternative: set FIREBASE_SERVICE_ACCOUNT_JSON to the minified JSON string.
# FIREBASE_SERVICE_ACCOUNT_JSON=
