# Copy to .env. Never commit .env or service-account JSON.
ENVIRONMENT=development

# Create a key at https://console.groq.com/keys
GROQ_API_KEY=your_new_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Local frontend served with: python -m http.server 5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Absolute path to your Firebase Admin service-account JSON file.
# Example (Windows): C:/Users/YourUsername/Downloads/firebase-admin.json
# Example (Linux): /home/yourusername/Downloads/firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Alternative to the file path: set FIREBASE_SERVICE_ACCOUNT_JSON to the
# minified service-account JSON string. Do not set both options.
# FIREBASE_SERVICE_ACCOUNT_JSON=
